# ── Directory Index Configuration ───────────────────────────
DirectoryIndex index.php menu.php index.html

# ── Apache-Level CORS Headers ──────────────────────────────
# Ensures all responses include CORS headers even for OPTIONS preflight
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
    
    # Disable caching for live UI development
    <FilesMatch "\.(css|js|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Handle OPTIONS preflight at Apache level (before PHP)
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route /products and /api/products
    RewriteRule ^(api/)?products/?$ api_products.php [QSA,L]

    # Route /orders and /api/orders
    RewriteRule ^(api/)?orders/?$ api_orders.php [QSA,L]
</IfModule>
